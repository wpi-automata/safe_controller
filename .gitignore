# ROS 2 build and install artifacts
build/
install/
log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# VSCode settings (optional)
.vscode/

# Colcon meta files
.colcon/

# numpy debug logs
*.npz

# All CSV files
*.csv

# All png files
*.png

# ROS 2 bags (a bag is a folder of metadata.yaml + .mcap/.db3 files;
# ignoring the contents hides the whole folder whatever it is named)
*.mcap
*.db3
*.db3-shm
*.db3-wal
metadata.yaml
