<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>safe_controller</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="walia.rohan@gmail.com">rwalia</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <!-- Float32 (/lane_position), Float64MultiArray (/lane_keeping/cbf_debug),
       Int8 (/occlusion/state): clauded.py, occluder.py -->
  <depend>std_msgs</depend>
  <!-- sensor_msgs/Image: occluder.py subscribes to /rgb and publishes /rgb_occluded -->
  <depend>sensor_msgs</depend>
  <!-- Converts sensor_msgs/Image <-> numpy arrays so occluder.py can mask pixels -->
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
